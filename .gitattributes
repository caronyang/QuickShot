# Normalise line endings; keep binary assets untouched.
* text=auto

*.png binary
*.ico binary
*.exe binary
*.dll binary

*.cs text eol=lf
*.xaml text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.iss text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf
