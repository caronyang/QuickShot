<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>QuickShot</AssemblyName>
    <RootNamespace>QuickShot</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>

    <ApplicationIcon>Assets\quickshot.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>QuickShot</Product>
    <AssemblyTitle>QuickShot</AssemblyTitle>
    <Description>Quick region capture with floating snapshots</Description>
    <Company>QuickShot</Company>
    <Version>1.0.2</Version>
    <FileVersion>1.0.2.0</FileVersion>
    <NeutralLanguage>en</NeutralLanguage>
    <Copyright>Copyright (c) 2026</Copyright>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Explicit: the WPF SDK does not glob image files into Resource items. -->
    <Resource Include="Assets\quickshot.ico" />
    <Resource Include="Assets\logo-256.png" />
  </ItemGroup>

</Project>
