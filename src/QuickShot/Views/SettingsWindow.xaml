<Window x:Class="QuickShot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:QuickShot.Resources"
        Title="{res:Loc Settings_Title}"
        Width="700"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        FontSize="12.5">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6B7280" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- language -->
        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Text="{res:Loc Settings_Language}" />
        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                  x:Name="LanguageCombo" Margin="0,2"
                  SelectionChanged="OnLanguageChanged" />
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                   Style="{StaticResource FieldHint}" Text="{res:Loc Settings_LanguageHint}" />

        <!-- hotkey -->
        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Text="{res:Loc Settings_Hotkey}" />
        <TextBox Grid.Row="2" Grid.Column="1"
                 x:Name="HotkeyBox"
                 IsReadOnly="True"
                 Cursor="Hand"
                 Padding="5,4"
                 PreviewKeyDown="OnHotkeyKeyDown" />
        <Button Grid.Row="2" Grid.Column="2"
                x:Name="HotkeyResetButton"
                Content="{res:Loc Settings_HotkeyReset}"
                Padding="10,3"
                MinWidth="86"
                Margin="10,0,0,0"
                Click="OnHotkeyResetClick" />
        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
            <TextBlock Style="{StaticResource FieldHint}" Text="{res:Loc Settings_HotkeyHint}" />
            <TextBlock x:Name="HotkeyWarning"
                       Foreground="#FFC0392B"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,-4,0,10"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- start with windows -->
        <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                  x:Name="AutoStartCheck" Margin="0,2"
                  Content="{res:Loc Settings_AutoStart}" />
        <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                   Style="{StaticResource FieldHint}"
                   Text="{res:Loc Settings_AutoStartHint}" />
        <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                   x:Name="AutoStartWarning"
                   Foreground="#FF6B7280" FontSize="11"
                   TextWrapping="Wrap" Margin="0,-6,0,10"
                   Visibility="Collapsed" />

        <!-- save folder -->
        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Text="{res:Loc Settings_SaveFolder}" />
        <TextBox Grid.Row="6" Grid.Column="1"
                 x:Name="SaveFolderBox"
                 IsReadOnly="True"
                 Padding="5,4" />
        <Button Grid.Row="6" Grid.Column="2"
                Content="{res:Loc Settings_Browse}"
                Padding="10,3"
                Margin="8,0,0,0"
                Click="OnBrowseClick" />

        <!-- limit -->
        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Text="{res:Loc Settings_MaxSnapshots}" />
        <Slider Grid.Row="7" Grid.Column="1"
                x:Name="MaxSlider"
                Minimum="1" Maximum="20"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                VerticalAlignment="Center"
                Margin="0,6"
                ValueChanged="OnMaxChanged" />
        <TextBlock Grid.Row="7" Grid.Column="2"
                   x:Name="MaxValueText"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0" />
        <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                   Style="{StaticResource FieldHint}"
                   Text="{res:Loc Settings_MaxSnapshotsHint}" />

        <!-- opacity -->
        <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Text="{res:Loc Settings_Opacity}" />
        <Slider Grid.Row="9" Grid.Column="1"
                x:Name="OpacitySlider"
                Minimum="0.3" Maximum="1.0"
                SmallChange="0.05" LargeChange="0.1"
                TickFrequency="0.05" IsSnapToTickEnabled="True"
                VerticalAlignment="Center"
                Margin="0,6"
                ValueChanged="OnOpacityChanged" />
        <TextBlock Grid.Row="9" Grid.Column="2"
                   x:Name="OpacityValueText"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0" />

        <!-- toggles -->
        <CheckBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2"
                  x:Name="NotifyCheck" Margin="0,6,0,2"
                  Content="{res:Loc Settings_Notifications}" />
        <CheckBox Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2"
                  x:Name="PinCheck" Margin="0,2,0,2"
                  Content="{res:Loc Settings_PinNew}" />

        <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="SaveButton"
                    Content="{res:Loc Settings_Save}"
                    Width="100" Padding="0,5" Margin="0,0,8,0"
                    Click="OnSaveClick" />
            <Button x:Name="CancelButton"
                    Content="{res:Loc Settings_Cancel}"
                    Width="100" Padding="0,5"
                    Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
